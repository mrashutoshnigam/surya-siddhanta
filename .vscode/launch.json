{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "React App (FastAPI + Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:5173",
            "webRoot": "${workspaceFolder}/frontend",
            "preLaunchTask": "Run React App (API + frontend)"
        },
        {
            "name": "FastAPI Backend (uvicorn :8000)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "suryasiddhanta.api.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "python": "${userHome}\\miniconda3\\envs\\${input:condaEnv}\\python.exe",
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "React Frontend (Chrome :5173)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend",
            "preLaunchTask": "Run React Frontend (port 5173)"
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "${userHome}\\miniconda3\\envs\\${input:condaEnv}\\python.exe",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Pytest: All Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests",
                "-v"
            ],
            "python": "${userHome}\\miniconda3\\envs\\${input:condaEnv}\\python.exe",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Pytest: Current Test File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-v"
            ],
            "python": "${userHome}\\miniconda3\\envs\\${input:condaEnv}\\python.exe",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "condaEnv",
            "type": "promptString",
            "description": "Conda environment to run in (looked up under ~/miniconda3/envs)",
            "default": "surya"
        }
    ]
}
